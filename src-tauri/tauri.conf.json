{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEV Core Engine",
  "version": "0.1.4",
  "identifier": "com.mevarb.core",
  "build": {
    "beforeDevCommand": "npm run desktop:serve",
    "devUrl": "http://localhost:4100",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop/shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEV Core Engine",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/core/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
