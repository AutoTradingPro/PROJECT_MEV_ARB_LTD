{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEV Core Engine",
  "version": "0.1.0",
  "identifier": "com.mevarb.core",
  "build": {
    "beforeDevCommand": "npm run desktop:serve",
    "devUrl": "http://127.0.0.1:4100",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop/shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEV Core Engine",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
