# Salin ke .env.local (jangan commit kunci privat).
# Jaringan trading default: polygon | arbitrum | bsc | ethereum
NEXT_PUBLIC_DEFAULT_CHAIN=polygon
# Kosongkan agar switcher Ethereum / Polygon / Arbitrum aktif. Isi salah satu id untuk mengunci sesi.
SCANNER_LOCK_CHAIN=
NEXT_PUBLIC_SCANNER_LOCK_CHAIN=

# --- BNB Smart Chain (56) ---
# Server-only Blockmachine. Jangan taruh API key atau URL Blockmachine di NEXT_PUBLIC_.
BSC_RPC_URL=https://rpc-bsc.blockmachine.io
RPC_HTTP_URL=https://rpc-bsc.blockmachine.io
BSC_WSS_URL=wss://rpc-bsc.blockmachine.io
RPC_WSS_URL=wss://rpc-bsc.blockmachine.io
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_WS_URL=
NEXT_PUBLIC_BSC_RPC_URL_2=
NEXT_PUBLIC_BSC_WS_URL_2=
NEXT_PUBLIC_BSC_ARBITRAGE_EXECUTOR=0x564abBC67F07C7621F86EABe25346eb5C5c81c7c
NEXT_PUBLIC_BSC_FLASH_LOAN_POOL=
NEXT_PUBLIC_BSC_VAULT_CONTRACT=
PRIVATE_KEY_BSC=

# --- Arbitrum One (42161) ---
# Hibrida: Scanner=Alchemy · Executor=QuickNode MEV · Cadangan=Blockmachine
BLOCKMACHINE_API_KEY_ARBITRUM=bm_live_YOUR_ARBITRUM_KEY
ALCHEMY_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ARBITRUM_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBI_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBI_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_EXEC_RPC_URL=https://YOUR-NAME.arbitrum-mainnet.quiknode.pro/YOUR_TOKEN/
QUICKNODE_ARBITRUM_RPC_URL=https://YOUR-NAME.arbitrum-mainnet.quiknode.pro/YOUR_TOKEN/
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_ARBITRUM_WS_URL=wss://arbitrum-one.publicnode.com
NEXT_PUBLIC_ARBITRUM_RPC_URL_2=
NEXT_PUBLIC_ARBITRUM_WS_URL_2=
BLOCKPI_RPC_ARBITRUM=
NEXT_PUBLIC_ARBITRUM_FLASHBOTS_RPC_URL=
NEXT_PUBLIC_ARBITRUM_ARBITRAGE_EXECUTOR=
NEXT_PUBLIC_ARBITRUM_VAULT_CONTRACT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
NEXT_PUBLIC_BALANCER_FLASH_ARB=
WRAPPED_NATIVE_ARBITRUM=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
PRIVATE_KEY_ARBITRUM=

# Profit minimum bersih (ETH) setelah dipotong gas — batalkan flash loan jika di bawah ini
MIN_PROFIT_THRESHOLD=0.0005

# QuickNode MEV Protection — broadcast anti front-running (executor only)
MEV_PROTECTION_ENABLED=true
QUICKNODE_MEV_PROTECT=true
PRIVATE_RELAY_METHOD=eth_sendRawTransaction

# Alias tulis privat (fallback jika EXEC RPC kosong)
PRIVATE_RPC_URL=
PRIVATE_RELAY_URL=
OWNER_ADDRESS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
OWNER_BRANKAS_PASSWORD=

# Reown AppKit (WalletConnect Cloud) — https://dashboard.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Polygon PoS (137) — Alchemy scanner (server only) ---
BLOCKMACHINE_API_KEY_POLYGON=bm_live_YOUR_POLYGON_KEY
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLY_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_HTTP_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WSS_URL_POLYGON=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_EXEC_RPC_URL=https://YOUR-NAME.matic.quiknode.pro/YOUR_TOKEN/
QUICKNODE_POLYGON_RPC_URL=https://YOUR-NAME.matic.quiknode.pro/YOUR_TOKEN/
BLOCKPI_RPC_POLYGON=
PRIVATE_KEY_POLYGON=

# --- Ethereum (1) — Alchemy scanner · QuickNode executor ---
BLOCKMACHINE_API_KEY_ETHEREUM=bm_live_YOUR_ETHEREUM_KEY
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ETHEREUM_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHE_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_HTTP_URL_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WSS_URL_ETHEREUM=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_EXEC_RPC_URL=https://YOUR-NAME.ethereum-mainnet.quiknode.pro/YOUR_TOKEN/
QUICKNODE_ETHEREUM_RPC_URL=https://YOUR-NAME.ethereum-mainnet.quiknode.pro/YOUR_TOKEN/
BLOCKPI_RPC_ETHEREUM=
PRIVATE_KEY_ETHEREUM=

# Cadangan (Backup RPC) Blockmachine — HTTP Bearer / WSS ?authorization=
ETHEREUM_RPC_URL_2=https://rpc-eth.blockmachine.io
ETHEREUM_WSS_URL_2=wss://rpc-eth.blockmachine.io
POLYGON_RPC_URL_2=https://rpc-polygon.blockmachine.io
POLYGON_WSS_URL_2=wss://rpc-polygon.blockmachine.io
ARBITRUM_RPC_URL_2=https://rpc-arbitrum.blockmachine.io
ARBITRUM_WSS_URL_2=wss://rpc-arbitrum.blockmachine.io

# --- Optimism (10) — Backup RPC Blockmachine (server-only) ---
BLOCKMACHINE_API_KEY_OPTIMISM=bm_live_YOUR_OPTIMISM_KEY
OPTIMISM_RPC_URL_2=https://rpc-optimism.blockmachine.io
OPTIMISM_WSS_URL_2=wss://rpc-optimism.blockmachine.io

# --- Avalanche C-Chain (43114) — Backup RPC Blockmachine (server-only) ---
BLOCKMACHINE_API_KEY_AVALANCHE=bm_live_YOUR_AVALANCHE_KEY
AVALANCHE_RPC_URL_2=https://rpc-avalanche.blockmachine.io
AVALANCHE_WSS_URL_2=wss://rpc-avalanche.blockmachine.io
